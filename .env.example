# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ajeer_permits

# Port for the server
PORT=3000

# The base URL of your LIVE website (used to build the QR code link).
# This must be the real public domain so the QR works when scanned on a phone.
# Example based on your cPanel domain:
BASE_URL=https://crm.pakistanrecoveryoasis.com

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ajeer_permits

# Port for the server
PORT=3000

# The base URL of your LIVE website (used to build the QR code link).
# This must be the real public domain so the QR works when scanned on a phone.
BASE_URL=https://crm.pakistanrecoveryoasis.com

# ── Pricing Configuration ───────────────────────────────────────────────────
PRICE_PER_PERSON=22.35
PAYMENT_CURRENCY=SAR

# ── Active Payment Gateway (UBL | HBL | SAFEPAY) ────────────────────────────
PAYMENT_GATEWAY=UBL
PAYMENT_ENVIRONMENT=sandbox

# ── UBL E-Commerce Payment Gateway ──────────────────────────────────────────
# Obtain these from UBL after merchant onboarding.
# Do NOT commit real production credentials to version control.
UBL_MERCHANT_ID=
UBL_API_KEY=
UBL_SECRET_KEY=
UBL_TERMINAL_ID=
UBL_GATEWAY_URL=
UBL_ENVIRONMENT=sandbox
UBL_RETURN_URL=https://crm.pakistanrecoveryoasis.com/api/payments/ubl/return
UBL_CALLBACK_URL=https://crm.pakistanrecoveryoasis.com/api/payments/ubl/callback
